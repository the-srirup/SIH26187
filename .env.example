# IBVAP configuration — copy this file to `.env` and adjust as needed.
# The real `.env` is git-ignored; never commit secrets.
#   cp .env.example .env

# Core
PROJECT_NAME=IBVAP
VERSION=1.0.0

# Database
DATABASE_URL=sqlite:///./alerts.db

# Model / CV
MODEL_PATH=yolo11n.pt
TRACKER=bytetrack.yaml
BUFFER_SIZE=150
POST_ALERT_FRAMES=50
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=5

# Rules / detection
MIN_OBJECT_AREA=300
DEFAULT_CONFIDENCE=0.25
DEBOUNCE_SECONDS=10.0
LOITER_SECONDS=60

# Face recognition / watchlist
FACE_RECOGNITION_EVERY_N_FRAMES=5
FACE_MIN_HEIGHT=40
FACE_MATCH_CACHE_SECONDS=30
FACE_SIMILARITY_THRESHOLD=0.55
FACE_ALERT_DEBOUNCE_SECONDS=30

# ANPR
ANPR_ENABLED=true
ANPR_CONFIDENCE_THRESHOLD=0.45
ANPR_MIN_PLATE_AREA=700
ANPR_MIN_ASPECT_RATIO=1.6
ANPR_MAX_ASPECT_RATIO=6.5
ANPR_ALERT_DEBOUNCE_SECONDS=12

# Server
HOST=0.0.0.0
PORT=8000

# Demo (single camera feed)
DEFAULT_CAMERA_URL=
