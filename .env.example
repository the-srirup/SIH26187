# IBVAP configuration — copy to `.env` and adjust.
#     cp .env.example .env
# The real `.env` is git-ignored; never commit secrets.
#
# Every value below has a working default in core/config.py. Uncomment only
# what you need to change for your deployment.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# PROJECT_NAME=IBVAP
# LOG_LEVEL=INFO                # DEBUG for verbose pipeline tracing
# DATABASE_URL=sqlite:///./alerts.db

# ---------------------------------------------------------------------------
# Detection model
# ---------------------------------------------------------------------------
# MODEL_PATH=yolo11n.pt         # yolo11s.pt for higher accuracy on a stronger GPU
# DEVICE=auto                   # auto | cpu | cuda:0
# USE_HALF=true                 # FP16 on CUDA; ignored on CPU
# INFERENCE_IMGSZ=640           # set 480 on a CPU-only host (~1.8x faster)
# DEFAULT_CONFIDENCE=0.30
# NMS_IOU=0.45
# MIN_OBJECT_AREA=400           # px^2 — ignore specks
# INFERENCE_BATCHING=true       # batch concurrent cameras into one forward pass
# INFERENCE_BATCH_MAX=8

# ---------------------------------------------------------------------------
# Video pipeline
# ---------------------------------------------------------------------------
# FRAME_WIDTH=640
# FRAME_HEIGHT=384
# TARGET_FPS=15                 # analytics cadence; capture always runs full speed
# CAMERA_TIMEOUT=6.0            # seconds without a frame before OFFLINE
# RECONNECT_INTERVAL=4.0
# LOOP_FILE_SOURCES=true        # replay a finite video file as a live feed
# JPEG_QUALITY=72               # MJPEG stream quality

# ---------------------------------------------------------------------------
# Tracking
# ---------------------------------------------------------------------------
# TRACK_HIGH_THRESH=0.45
# TRACK_LOW_THRESH=0.10
# NEW_TRACK_THRESH=0.50
# TRACK_BUFFER=45               # frames a lost track survives
# MATCH_THRESH=0.85
# BOX_SMOOTHING=0.55            # render-only smoothing; rules use the raw foot point

# ---------------------------------------------------------------------------
# Rules & alerting
# ---------------------------------------------------------------------------
# DEBOUNCE_SECONDS=12.0         # cooldown per (rule, track, event)
# ANCHOR_CONFIRMATION_FRAMES=3  # frames the new side/zone must hold before firing
# LOITER_SECONDS=15.0
# ZONE_PRESENCE_SECONDS=5.0
# PRESENCE_ALERTS_ENABLED=true  # log first sighting of each person/vehicle
# PRESENCE_MIN_CONFIDENCE=0.55
# PRESENCE_DEBOUNCE_SECONDS=60.0
# TRACK_STATE_TTL=120.0

# ---------------------------------------------------------------------------
# Night mode (hours are IST / Asia-Kolkata)
# ---------------------------------------------------------------------------
# NIGHT_START_HOUR=19
# NIGHT_END_HOUR=6
# LOW_LIGHT_THRESHOLD=80.0      # mean luma below which CLAHE engages
# CLAHE_CLIP_LIMIT=2.5
# NIGHT_BY_LUMINANCE=true       # a genuinely dark frame counts as night
# FORCE_NIGHT_MODE=false        # set true to demo night analytics on day footage
# NIGHT_MOVEMENT_MIN_TRAVEL=45.0
# NIGHT_MOVEMENT_DEBOUNCE=45.0

# ---------------------------------------------------------------------------
# Evidence
# ---------------------------------------------------------------------------
# EVIDENCE_ENABLED=true
# CLIP_PRE_SECONDS=4.0          # rolling pre-roll captured before the trigger
# CLIP_POST_SECONDS=4.0
# MAX_EVIDENCE_MB=2048          # retention budget; oldest pruned first
# MAX_EVIDENCE_AGE_DAYS=30
# EVIDENCE_SWEEP_INTERVAL=900.0

# ---------------------------------------------------------------------------
# Face detection / watchlist
# ---------------------------------------------------------------------------
# FACE_ENABLED=true
# FACE_RECOGNITION_EVERY_N_FRAMES=12
# FACE_DET_SIZE=320             # SCRFD input; 640 is 4x the pixels for little gain
# FACE_MIN_HEIGHT=32
# FACE_SIMILARITY_THRESHOLD=0.55
# FACE_MAX_CROPS_PER_TICK=3     # bounds worst-case latency in a crowded frame
# FACE_DETECTION_ALERTS=true    # log "face detected" even without a watchlist match
# FACE_ALERT_DEBOUNCE_SECONDS=45.0
# FACE_DETECT_DEBOUNCE_SECONDS=60.0

# ---------------------------------------------------------------------------
# ANPR
# ---------------------------------------------------------------------------
# ANPR_ENABLED=true
# ANPR_EVERY_N_FRAMES=10        # OCR runs on this cadence, vehicles only
# ANPR_MAX_PLATES_PER_TICK=2
# ANPR_CONFIDENCE_THRESHOLD=0.45  # below this the overlay shows PLATE UNCERTAIN
# ANPR_ALERT_CONFIDENCE=0.55      # below this no plate number is written to the log
# ANPR_MIN_PLATE_AREA=500
# ANPR_MIN_ASPECT_RATIO=1.8
# ANPR_MAX_ASPECT_RATIO=6.5
# ANPR_ALERT_DEBOUNCE_SECONDS=30.0
# ANPR_LANGUAGES=en

# ---------------------------------------------------------------------------
# Video upload / offline analysis
# ---------------------------------------------------------------------------
# UPLOAD_MAX_MB=512
# UPLOAD_FRAME_STRIDE=2         # analyse every Nth decoded frame; 1 = every frame
# UPLOAD_RENDER_OUTPUT=true     # write an annotated MP4 of the analysis
# UPLOAD_MAX_CONCURRENT=1
# UPLOAD_KEEP_SESSIONS=25

# ---------------------------------------------------------------------------
# Integrity
# ---------------------------------------------------------------------------
# CHECKPOINT_INTERVAL=300.0     # seconds between Merkle checkpoints

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# CORS_ORIGINS=["*"]            # restrict for anything beyond a closed LAN
# MAX_STREAM_CLIENTS=12
