# IBVAP configuration — copy to `.env` and adjust.
#     cp .env.example .env
# The real `.env` is git-ignored; never commit secrets.
#
# Every value below has a working default in core/config.py. Uncomment only
# what you need to change for your deployment.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# PROJECT_NAME=IBVAP
# LOG_LEVEL=INFO                # DEBUG for verbose pipeline tracing
# DATABASE_URL=sqlite:///./alerts.db

# ---------------------------------------------------------------------------
# Detection model
# ---------------------------------------------------------------------------
# MODEL_PATH=yolo11n.pt         # yolo11s.pt for higher accuracy on a stronger GPU
# DEVICE=auto                   # auto | cpu | cuda:0
# USE_HALF=true                 # FP16 on CUDA; ignored on CPU
# INFERENCE_IMGSZ=640           # set 480 on a CPU-only host (~1.8x faster)
# DEFAULT_CONFIDENCE=0.30
# NMS_IOU=0.45
# MIN_OBJECT_AREA=400           # px^2 — ignore specks
# INFERENCE_BATCHING=true       # batch concurrent cameras into one forward pass
# INFERENCE_BATCH_MAX=8

# ---------------------------------------------------------------------------
# Video pipeline
# ---------------------------------------------------------------------------
# FRAME_WIDTH=640
# FRAME_HEIGHT=384
# TARGET_FPS=15                 # analytics cadence; capture always runs full speed
# CAMERA_TIMEOUT=6.0            # seconds without a frame before OFFLINE
# RECONNECT_INTERVAL=4.0
# LOOP_FILE_SOURCES=true        # replay a finite video file as a live feed
# JPEG_QUALITY=72               # MJPEG stream quality

# ---------------------------------------------------------------------------
# Tracking
# ---------------------------------------------------------------------------
# TRACK_HIGH_THRESH=0.45
# TRACK_LOW_THRESH=0.10
# NEW_TRACK_THRESH=0.32         # just above the detector floor, so a blurred
#                               # fast mover still gets a track identity
# TRACK_BUFFER=45               # frames a lost track survives
# MATCH_THRESH=0.92             # association gate; lower values cannot track
#                               # an object that moves more than its own length
# BOX_SMOOTHING=0.55            # render-only smoothing; rules use the raw foot point

# ---------------------------------------------------------------------------
# Rules & alerting
# ---------------------------------------------------------------------------
# DEBOUNCE_SECONDS=12.0         # cooldown per (rule, track, event)
# ANCHOR_CONFIRMATION_FRAMES=3  # frames the new side/zone must hold before firing
# LOITER_SECONDS=15.0
# ZONE_PRESENCE_SECONDS=5.0
# PRESENCE_ALERTS_ENABLED=true  # log first sighting of each person/vehicle
# PRESENCE_MIN_CONFIDENCE=0.55
# PRESENCE_DEBOUNCE_SECONDS=60.0
# TRACK_STATE_TTL=120.0

# ---------------------------------------------------------------------------
# Night mode — decided VISUALLY, from what the camera sees
# ---------------------------------------------------------------------------
# The clock is not an observation: a floodlit checkpost is not dark at 23:00
# and an unlit culvert is not bright at noon. Night is fused from dark-pixel
# fraction, mean luma and colour saturation (see cv/scene.py).
# NIGHT_DARKNESS_ENTER=0.55     # darkness score at which night engages
# NIGHT_DARKNESS_EXIT=0.40      # lower than ENTER — the gap is hysteresis
# NIGHT_CONFIRM_FRAMES=12       # agreeing frames before the latch flips
# NIGHT_DETECT_INFRARED=true    # recognise IR cameras (bright but colourless)
# NIGHT_USE_CLOCK_HINT=false    # clock may nudge a borderline scene; never trigger
# NIGHT_START_HOUR=19           # IST — only used when the hint is enabled
# NIGHT_END_HOUR=6              # IST
# LOW_LIGHT_THRESHOLD=80.0      # mean luma below which CLAHE engages
# CLAHE_CLIP_LIMIT=2.5
# FORCE_NIGHT_MODE=false        # set true to demo night analytics on day footage
# NIGHT_MOVEMENT_MIN_TRAVEL=45.0
# NIGHT_MOVEMENT_DEBOUNCE=45.0

# ---------------------------------------------------------------------------
# Evidence
# ---------------------------------------------------------------------------
# EVIDENCE_ENABLED=true
# CLIP_PRE_SECONDS=4.0          # rolling pre-roll captured before the trigger
# CLIP_POST_SECONDS=4.0
# MAX_EVIDENCE_MB=2048          # retention budget; oldest pruned first
# MAX_EVIDENCE_AGE_DAYS=30
# EVIDENCE_SWEEP_INTERVAL=900.0

# ---------------------------------------------------------------------------
# Face detection / watchlist
# ---------------------------------------------------------------------------
# FACE_ENABLED=true
# FACE_RECOGNITION_EVERY_N_FRAMES=12
# FACE_DET_SIZE=320             # SCRFD input; 640 is 4x the pixels for little gain
# FACE_MIN_HEIGHT=32
# FACE_SIMILARITY_THRESHOLD=0.55
# FACE_MAX_CROPS_PER_TICK=3     # bounds worst-case latency in a crowded frame
# FACE_DETECTION_ALERTS=true    # log "face detected" even without a watchlist match
# FACE_ALERT_DEBOUNCE_SECONDS=45.0
# FACE_DETECT_DEBOUNCE_SECONDS=60.0

# ---------------------------------------------------------------------------
# ANPR
# ---------------------------------------------------------------------------
# ANPR_ENABLED=true
# ANPR_EVERY_N_FRAMES=10        # OCR runs on this cadence, vehicles only
# ANPR_MAX_PLATES_PER_TICK=2
# ANPR_CONFIDENCE_THRESHOLD=0.45  # below this the overlay shows PLATE UNCERTAIN
# ANPR_ALERT_CONFIDENCE=0.55      # below this no plate number is written to the log
# ANPR_MIN_PLATE_AREA=120       # candidate geometry is relative to the searched
# ANPR_MIN_ASPECT_RATIO=1.8     # region, not the whole frame
# ANPR_MAX_ASPECT_RATIO=6.5
# ANPR_ALERT_DEBOUNCE_SECONDS=30.0
# ANPR_LANGUAGES=en
# ANPR_CONSENSUS_ENABLED=true   # decide a plate by majority vote across frames
# ANPR_MIN_VOTES=2              # corroborating reads before a plate is logged

# ---------------------------------------------------------------------------
# Notifications — alarm siren & SMS escalation
# ---------------------------------------------------------------------------
# Both channels are OFF by default: they reach real hardware and a metered
# gateway. Turning one on without configuring a sink is a no-op that reports
# itself as "enabled but not configured" on /api/system/notifications.
#
# Only CRITICAL and HIGH events escalate. Dispatch happens on a worker thread,
# so an unreachable siren controller can never stall a camera's analytics.
#
# NOTIFY_MIN_SEVERITY=HIGH      # HIGH | CRITICAL — floor for escalation
# NOTIFY_QUEUE_SIZE=64          # events buffered per channel before dropping

# -- Alarm / siren -----------------------------------------------------------
# Sink 1: an HTTP alarm controller (IP siren, relay board, PA, dispatch API).
# Sink 2: a GPIO relay on a single-board host. Either or both may be set; the
# alarm counts as delivered if any configured sink fires.
# ALARM_ENABLED=false
# ALARM_WEBHOOK_URL=http://192.168.1.50/api/siren/trigger
# ALARM_WEBHOOK_SECRET=change-me    # HMAC-SHA256 key for X-IBVAP-Signature
# ALARM_WEBHOOK_TIMEOUT=5.0
# ALARM_COOLDOWN_SECONDS=60.0   # quiet period per (camera, alert type)
# ALARM_GPIO_PIN=-1             # BCM pin; -1 disables the GPIO sink
# ALARM_GPIO_DURATION_SECONDS=5
# ALARM_GPIO_ACTIVE_HIGH=true   # set false for an active-LOW relay board,
#                               # or the siren is wired permanently ON

# -- SMS ---------------------------------------------------------------------
# SMS_ENABLED=false
# SMS_PROVIDER=twilio           # twilio | msg91 — the other is the fallback
# SMS_TO_NUMBER=+919876543210   # comma-separate for several recipients
# SMS_DEFAULT_COUNTRY_CODE=91   # applied to a bare 10-digit number
# SMS_COOLDOWN_SECONDS=120.0
# SMS_TIMEOUT=10.0

# Twilio — needs `pip install twilio`; without it this provider is skipped.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+12025550123

# MSG91 (India) — no extra dependency. Indian DLT rules require transactional
# SMS to be sent against a registered template, so the v5 flow API is used and
# the alert text rides in a template variable.
# MSG91_AUTH_KEY=your-auth-key
# MSG91_TEMPLATE_ID=your-dlt-template-id
# MSG91_SENDER_ID=IBVAPS
# MSG91_MESSAGE_VAR=MESSAGE     # template variable carrying the alert text

# ---------------------------------------------------------------------------
# Video upload / offline analysis
# ---------------------------------------------------------------------------
# UPLOAD_MAX_MB=512
# UPLOAD_FRAME_STRIDE=2         # analyse every Nth decoded frame; 1 = every frame
# UPLOAD_RENDER_OUTPUT=true     # write an annotated MP4 of the analysis
# UPLOAD_MAX_CONCURRENT=1
# UPLOAD_KEEP_SESSIONS=25

# ---------------------------------------------------------------------------
# Integrity
# ---------------------------------------------------------------------------
# CHECKPOINT_INTERVAL=300.0     # seconds between Merkle checkpoints

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# CORS_ORIGINS=["*"]            # restrict for anything beyond a closed LAN
# MAX_STREAM_CLIENTS=12

# ---------------------------------------------------------------------------
# Startup behaviour
# ---------------------------------------------------------------------------
# Every start begins by reconciling the database with reality: nothing is
# ONLINE until a processor in this process says so. That runs unconditionally
# and on the way IN, because a shutdown hook does not execute when the process
# is killed, when the terminal closes, or when the machine loses power — and
# those are exactly the terminations that leave a camera flagged online with no
# thread behind it, so the next boot paints a green tile for a dead camera.
#
# Bring previously registered cameras back up on boot. True is right for a
# deployed Border Out Post: the box reboots and the post is watched again with
# nobody logged in.
# AUTOSTART_CAMERAS=true
#
# Start as though the software had just been installed — every camera retired
# at boot, dashboard empty. Off by default because it destroys an operator's
# camera configuration; on for a development machine or a demo rig. The audit
# chain is never affected: a camera owning sealed events is archived, not
# deleted, because alerts.camera_id must still resolve.
# FRESH_START=false
#
# Or per-run, without editing anything:
#   python manage.py run --fresh
#   python manage.py run --no-autostart

# ---------------------------------------------------------------------------
# Log retention
# ---------------------------------------------------------------------------
# The operational log rotates at LOG_MAX_MB and keeps LOG_BACKUP_COUNT previous
# files, so the worst case on disk is bounded and knowable:
# LOG_MAX_MB * (LOG_BACKUP_COUNT + 1). It previously used a plain FileHandler,
# which never truncates — an unbounded file on an unattended deployment.
# LOG_MAX_MB=10
# LOG_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# Alert escalation
# ---------------------------------------------------------------------------
# Severity at or above which an event interrupts a human — the desktop
# notification and the alarm tone in the dashboard. HIGH by default, which is
# the line between "a security event" and "something was detected".
#
# Below the line an event is still sealed, still listed and still drawn on the
# tile; it simply makes no noise. Without that line an operator watching a road
# gets a notification per passing car and learns to dismiss all of them —
# including the intrusion that arrives between them.
#
#   CRITICAL  fence crossed inward, sustained presence in a zone, watchlist hit
#   HIGH      zone entry, loitering, wrong direction, night movement, offline
#   MEDIUM    fence crossed outward, degraded subsystem
#   LOW       zone exit, plate read, face seen
#   INFO      human_detected / vehicle_detected — routine traffic
#
# The dashboard reads this from /api/system/info, so changing it here is enough.
# NOTIFY_MIN_SEVERITY=HIGH

# ---------------------------------------------------------------------------
# Continuous zone signal
# ---------------------------------------------------------------------------
# An occupied zone is a continuing condition, not a moment. The live signal for
# it is state — it rides the 1 Hz stats socket, tints the polygon on the video
# and holds the dashboard banner and alert tone — because writing an event per
# frame would bury the hash-chained audit log under thousands of identical rows.
#
# This is the compromise for the log itself: one `zone_presence` event per
# interval for as long as the subject remains, so the record shows a continuing
# intrusion rather than a single entry followed by silence. Set to 0 to announce
# sustained presence only once.
# ZONE_PRESENCE_REPEAT_SECONDS=30.0

# ---------------------------------------------------------------------------
# Enrichment stage budget
# ---------------------------------------------------------------------------
# Face recognition and ANPR run beside the frame pipeline, never inside it.
# This is the ceiling on the share of wall-clock time they may consume: after a
# tick lasting T, the next is held off for T*(1/duty - 1).
#
# The frame cadence alone cannot bound them, because it is counted in frames —
# on a CPU-only face stack a tick costs about as long as the cadence gating it,
# so the stage ends up running continuously. Measured with that happening: YOLO
# inference rose from ~17 ms to ~97 ms and the pipeline fell from 15 fps to 8.3.
# Raise this on a host with CUDA onnxruntime, where a tick is cheap.
# STAGE_MAX_DUTY=0.25

# ---------------------------------------------------------------------------
# Hard reset  (POST /api/system/hard-reset, python manage.py hard-reset)
# ---------------------------------------------------------------------------
# Wipes every camera, rule, sealed event, checkpoint, analysis run, plate
# reading, face record and watchlist entry, stops every camera pipeline, and
# restarts the integrity chain from genesis. It exists so an operator has one
# honest way to start over before a demonstration — and because deleting
# "most" of the log would leave verification permanently broken instead.
#
# The endpoint always requires ?confirm=true. Set a token for anything
# reachable beyond a closed BOP LAN (sent as X-Reset-Token or ?token=), or
# switch the endpoint off entirely; the CLI is unaffected either way, since it
# already requires shell access to the host.
# HARD_RESET_ENABLED=true
# HARD_RESET_TOKEN=
# Evidence on disk is kept by default: a wiped database can be restored from a
# backup, deleted footage cannot. --evidence / ?wipe_evidence=true override it.
# HARD_RESET_WIPE_EVIDENCE=false
